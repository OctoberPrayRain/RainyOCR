#Please do not change the var's name 请不要更改变量名

#OpenAI Standard,Translate Model API Key 遵循OpenAI调用格式的翻译模型

#模型名称 Model Name
OpenAI_Translate_Model_Name = ""

#模型密钥 Model API KEY
OpenAI_Translate_Secret_Key = ""

#模型端点 / Base URL. Both base URL and full /chat/completions URL are accepted.
OpenAI_Translate_Node = ""

#OpenAI Standard,OCR Model  API Key  遵循OpenAI调用格式的OCR模型

#模型名称 Model Name
OpenAI_OCR_Model_Name = ""

#模型密钥 Model API KEY
OpenAI_OCR_Secret_Key = ""

#模型端点 / Base URL. Both base URL and full /chat/completions URL are accepted.
OpenAI_OCR_Node = ""

#启用本地 RapidOCR 进行 OCR；翻译仍使用在线翻译模型 / Enable local RapidOCR for OCR; translation still uses the online translate model
RainyOCR_Use_Local_OCR = "false"

#RainyOCR UI 设置 RainyOCR UI Settings

#翻译结果字体大小 Translation result font size
RainyOCR_Translation_Font_Size = "15"

#截图翻译快捷键 Capture and translate shortcut
RainyOCR_Capture_Shortcut = "Ctrl+Shift+T"
